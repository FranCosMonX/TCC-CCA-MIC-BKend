# Python bytecode (compiled files)
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (always exclude local dependencies)
venv/
.venv/
env/
ENV/

# Flask-specific instances and cache
instance/
.webassets-cache

# Environment variables and secrets (CRITICAL: Do not commit keys)
.env
.flaskenv
*.env

# SQLite databases (if used for local testing)
*.db
database.db
*.sqlite3

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Ide and editor settings
.vscode/
.idea/
